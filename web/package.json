{
  "name": "chaos-index-static-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "next:dev": "next dev -H 127.0.0.1 -p 3000",
    "static:dev": "python3 -m http.server 3000 -d public --bind 127.0.0.1",
    "build": "node scripts/build-static-site.mjs",
    "next:build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "generate:staging-data": "node --import tsx scripts/generate-staging-data.ts",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "find . -path './node_modules' -prune -o \\( -name '*.test.ts' -o -name '*.test.tsx' \\) -print | sort | xargs node --test --import tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.11.30",
    "@types/react": "18.2.74",
    "@types/react-dom": "18.2.24",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "tsx": "^4.21.0",
    "typescript": "5.4.5"
  }
}
